# Copie para .env e preencha (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://SEU_REF.supabase.co

# Recomendado para cadastro (signUp): anon ou publishable (sb_publishable_*)
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Operações admin no gerenciador (RLS bypass): service_role JWT ou sb_secret_*
# VITE_SUPABASE_SERVICE_ROLE_KEY=
# VITE_SUPABASE_SECRET_KEY=
